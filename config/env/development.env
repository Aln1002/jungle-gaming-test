NODE_ENV=development
PORT=3000

# OIDC Auth
OIDC_ISSUER_URL=http://localhost:8080/realms/wagering
OIDC_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wagering-api
OIDC_PROVIDER_ID_CLAIM=providerId

# Database
DATABASE_URL=postgresql://postgres:local-dev-only@127.0.0.1:5433/wagering
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=local-dev-only
DB_NAME=wagering
DB_SSL=false

# AWS SQS / LocalStack
SQS_ENDPOINT=http://localhost:4566
SQS_ACCOUNT_ID=000000000000
SQS_TRANSACTION_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_TRANSACTION_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENT_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_EVENT_DLQ_URL=http://localhost:4566/000000000000/wager-events-dlq.fifo
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
SQS_VISIBILITY_TIMEOUT_SECONDS=30
