{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "A distributed, idempotent wagering transaction processor",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "bunx nest build",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "bun dist/src/main.js",
    "migration:run": "bun scripts/migrate.ts run",
    "migration:revert": "bun scripts/migrate.ts revert",
    "queues:local": "bun scripts/create-local-queues.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:integration": "bun test test/integration",
    "test:load": "bun scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1166.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jose": "^6.2.17",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  }
}
