{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (Bun)",
      "type": "bun",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.ts",
      "cwd": "${workspaceFolder}",
      "runtime": "bun",
      "runtimeArgs": ["--no-env-file"],
      "stopOnEntry": false,
      "watchMode": false,
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Debug API (Node.js fallback)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Build API for debugging",
      "program": "${workspaceFolder}/dist/src/main.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ],
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
